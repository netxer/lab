# === Terraform ===
# Local .terraform directories
**/.terraform/*

# .tfstate files (contain secrets and state)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json
!example.tfvars
!example.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock files - usually you DO want to commit these, but uncomment if not
# .terraform.lock.hcl

# Plan output files
*.tfplan

# === Packer ===
# Variable files (often contain secrets)
*.pkrvars.hcl
*.pkrvars.json
!example.pkrvars.hcl
!example.pkrvars.json

# Packer cache
packer_cache/

# Packer crash log
crash.log

# Built artifacts
*.box
*.qcow2
*.raw
*.vmdk
*.ova

# === SSH keys / secrets ===
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
ansible_key*

# === General ===
.env
.env.local
.DS_Store
*.swp
*.swo
*.iso
*.log
*.ini
*.yml
.claud